{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://storyforge.local/harness/story-element-v1.schema.json",
  "title": "StoryForge semantic story element set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "elements"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "sourceSummary": { "type": "string" },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/element" }
    }
  },
  "definitions": {
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "summary"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "type": {
          "enum": ["character", "place", "event", "object", "concept", "faction", "species", "scene", "beat", "theme", "relationship"]
        },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "attributes": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        },
        "narrative": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "role": { "type": "string" },
            "importance": { "type": "number", "minimum": 0, "maximum": 1 },
            "arc": { "type": "string" },
            "tension": { "type": "string" },
            "emotion": { "type": "string" }
          }
        },
        "temporal": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "order": { "type": "number" },
            "label": { "type": "string" },
            "start": { "type": "string" },
            "end": { "type": "string" }
          }
        },
        "spatial": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "parentId": { "type": "string" },
            "label": { "type": "string" },
            "x": { "type": "number" },
            "y": { "type": "number" },
            "z": { "type": "number" }
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["targetId", "type"],
            "properties": {
              "targetId": { "type": "string" },
              "type": { "type": "string" },
              "label": { "type": "string" },
              "weight": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "sensory": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "visual": { "type": "array", "items": { "type": "string" } },
            "audio": { "type": "array", "items": { "type": "string" } },
            "atmosphere": { "type": "array", "items": { "type": "string" } }
          }
        },
        "sourceRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "certainty": { "enum": ["asserted", "inferred", "speculative"] }
      }
    }
  }
}
