rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /storyworlds/{worldId} {
      allow read: if true;
      allow write: if false;

      match /packages/{packageId} {
        allow read: if true;
        allow write: if false;

        match /revisions/{revisionId} {
          allow read, write: if false;
        }
      }

      match /drafts/{packageId} {
        allow read, write: if false;

        match /revisions/{revisionId} {
          allow read, write: if false;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
