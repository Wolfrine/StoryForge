{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://storyforge.local/schema/storyworld.schema.json",
  "title": "StoryForge Storyworld",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "entities", "relationships"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "entities": {
      "type": "array",
      "items": { "$ref": "./entity.schema.json" }
    },
    "relationships": {
      "type": "array",
      "items": { "$ref": "./relationship.schema.json" }
    }
  }
}
