{
  "name": "storyforge",
  "version": "1.0.0-alpha.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run compile:world && vite",
    "compile:world": "node scripts/compile-world.mjs",
    "validate:world": "node scripts/validate-world.mjs",
    "build": "npm run validate:world && npm run compile:world && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run validate:world && npm run compile:world && npm run typecheck"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
