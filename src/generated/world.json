      "kind": "event",
      "title": "The Cessation",
      "summary": "A global failure of engineered electrical conduction that collapses systems while leaving biological electrochemistry intact.",
      "entry": {
        "priority": 5,
        "featured": true
      },
      "tags": [
        "world event",
        "collapse",
        "ambiguity"
      ],
      "theme": {
        "palette": {
          "background": "#f0e8e1",
          "foreground": "#3b3031",
          "surface": "#faf5f0",
          "muted": "#7a6967",
          "accent": "#b94e40"
